{
  "name": "mawaqie-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm --parallel -r build",
    "lint": "pnpm --parallel -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "db:migrate": "pnpm --filter @mawaqie/api prisma:migrate",
    "db:seed": "pnpm --filter @mawaqie/api db:seed",
    "db:reset-admin": "pnpm --filter @mawaqie/api db:reset-admin",
    "db:bootstrap": "pnpm --filter @mawaqie/api db:bootstrap",
    "db:studio": "pnpm --filter @mawaqie/api prisma studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=9 <11"
  }
}
